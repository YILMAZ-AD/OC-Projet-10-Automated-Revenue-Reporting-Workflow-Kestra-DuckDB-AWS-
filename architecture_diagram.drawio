        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Fichiers sources\n    A1[Fichier source: erp.xlsx]\n    A2[Fichier source: liaison.xlsx]\n    A3[Fichier source: web.xlsx]\n\n    %% Nettoyages\n    A1 --&gt; B1[Nettoyage ERP:&lt;br&gt;dédoublonnage,&lt;br&gt;retirer prix negatifs ou nuls]\n    A2 --&gt; B3[Nettoyage Liaison:&lt;br&gt;dédoublonnage,&lt;br&gt;retirer id_web nuls]\n    A3 --&gt; B2[Nettoyage Web:&lt;br&gt;dédoublonnage,&lt;br&gt;garder post_type=product,&lt;br&gt;sku non nul]\n\n    %% Tests de nettoyage\n    B1 --&gt; T1{Test nettoyage ERP:&lt;br&gt;aucun prix negatif,&lt;br&gt;0 doublon}\n    B3 --&gt; T3_L{Test nettoyage Liaison:&lt;br&gt;0 doublon,&lt;br&gt;aucun id_web nul}\n    B2 --&gt; T2{Test nettoyage Web:&lt;br&gt;0 doublon,&lt;br&gt;uniquement produits valides}\n\n    %% Alertes KO nettoyages\n    T1 -- KO --&gt; X1[Alerte: nettoyage&lt;br&gt;ERP invalide]\n    T3_L -- KO --&gt; X3_L[Alerte: nettoyage&lt;br&gt;Liaison invalide]\n    T2 -- KO --&gt; X2[Alerte: nettoyage&lt;br&gt;Web invalide]\n\n    %% Jointures\n    T1 -- OK --&gt; C1[Jointure 1:&lt;br&gt;ERP + Liaison&lt;br&gt;via product_id]\n    T3_L -- OK --&gt; C1\n    \n    C1 --&gt; C2[Jointure 2:&lt;br&gt;Resultat + Web&lt;br&gt;via id_web = sku]\n    T2 -- OK --&gt; C2\n\n    %% Test de jointure\n    C2 --&gt; T3{Test jointure:&lt;br&gt;coherente, pas de&lt;br&gt;doublons crees}\n    T3 -- KO --&gt; X3[Alerte: jointure&lt;br&gt;incoherente]\n    \n    %% Calcul CA\n    T3 -- OK --&gt; D[Calcul du CA:&lt;br&gt;prix ERP x quantite vendue web]\n    D --&gt; T4{Test calcul CA:&lt;br&gt;somme des CA produits&lt;br&gt;= CA total}\n    T4 -- KO --&gt; X4[Alerte: calcul CA&lt;br&gt;incorrect]\n\n    %% Exports et segmentations\n    T4 -- OK --&gt; E1[Extraction rapport Excel:&lt;br&gt;CA par produit + CA total]\n    T4 -- OK --&gt; E2[Identification vins:&lt;br&gt;z-score sur le prix ERP]\n\n    %% Tests Finaux\n    E1 --&gt; T5{Test rapport:&lt;br&gt;fichier non vide,&lt;br&gt;colonnes attendues}\n    E2 --&gt; T6{Test z-score:&lt;br&gt;distribution et&lt;br&gt;seuil coherents}\n\n    %% Fin de branche Excel\n    T5 -- KO --&gt; X5[Alerte: Erreur,&lt;br&gt;rapport final invalide]\n    T5 -- OK --&gt; F3(((Succès: Rapport Excel&lt;br&gt;disponible et réalisé)))\n\n    %% Fin de branche Z-Score\n    T6 -- KO --&gt; X6[Alerte: Erreur sur&lt;br&gt;la distribution Z-score]\n    T6 -- OK --&gt; F1[Extraction vins premium&lt;br&gt;au format .csv]\n    T6 -- OK --&gt; F2[Extraction vins ordinaires&lt;br&gt;au format .csv]&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dx6I4q1b1tNoXPJfLbSV-1">
